{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // NodeNext is the correct resolution for an ESM Node package: it makes
    // TypeScript check import specifiers the same way Node resolves them.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  "include": ["src"]
}
