# Copy to .env to override the Docker Compose defaults. Never commit .env.
# These are consumed by docker-compose.yml only; the api has its own
# api/.env.example.
POSTGRES_USER=opensetlist
POSTGRES_PASSWORD=opensetlist
POSTGRES_DB=opensetlist
POSTGRES_PORT=5432
API_PORT=3000
WEB_PORT=5173
# Where the Vite dev server proxies /api to (Compose service name of the api)
API_PROXY_TARGET=http://api:3000
